{
  "name": "ficus-infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "plan": "bun --bun alchemy plan alchemy.run.ts --stage ${STAGE:-dev}",
    "deploy": "bun --bun alchemy deploy alchemy.run.ts --stage ${STAGE:-dev} --yes",
    "destroy": "bun --bun alchemy destroy alchemy.run.ts --stage ${STAGE:-dev}",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/agents && tsc --noEmit -p src/api && tsc --noEmit -p src/sandbox",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test ./src/",
    "clef-review": "bun --bun ./src/clef/review.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "auth:schema": "bun ./scripts/auth-schema.ts",
    "dev": "bun --bun alchemy dev alchemy.run.ts --stage ${STAGE:-local}",
    "plan:bootstrap": "bun --bun alchemy plan bootstrap.run.ts --stage bootstrap",
    "deploy:bootstrap": "bun --bun alchemy deploy bootstrap.run.ts --stage bootstrap",
    "destroy:ci": "bun --bun alchemy destroy alchemy.run.ts --stage ${STAGE:?a pr-<n> stage} --yes"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "https://pkg.alchemy.run/@alchemy.run/better-auth/pr:1904:1c859a3",
    "@better-auth/api-key": "1.7.7",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "agents": "0.26.0",
    "alchemy": "https://pkg.alchemy.run/alchemy/pr:1904:1c859a3",
    "better-auth": "1.7.7",
    "effect": "4.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@oxlint/plugins": "1.86.0",
    "@types/bun": "1.4.2",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
