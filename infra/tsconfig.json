{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Diagnostics come from oxlint (.oxlintrc.json); the language service
    // keeps hovers and refactors without reporting every finding twice.
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  },
  "include": ["alchemy.run.ts", "src", "scripts"],
  // Each has its own tsconfig.json with its runtime's types.
  "exclude": ["src/agents", "src/api", "src/sandbox"]
}
