#!/usr/bin/env bash
# Bundle ficus-scorer (infra/src/scorer, Effect TypeScript) into one file in
# the container's Docker context; the image runs it under bun.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root/infra"
bun build src/scorer/main.ts --target=bun --outfile src/sandbox/context/ficus-scorer.js
ls -la src/sandbox/context/ficus-scorer.js
